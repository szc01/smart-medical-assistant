# ==========================================
# 智能医疗助手 - 后端环境变量模板
# 用法：复制为 backend/.env 后填入真实值
#   cp backend/.env.example backend/.env
# 注意：.env 已被 .gitignore 忽略，请勿提交
# ==========================================

# ---------- AI 模型（阿里云百炼 / DashScope） ----------
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=<填入百炼 API Key>

# ---------- 联网搜索（Tavily） ----------
# 获取地址：https://app.tavily.com/
TAVILY_API_KEY=<填入 Tavily API Key>

# ---------- 联网搜索（DeepSeek Search API，可选替代 Tavily） ----------
# 获取地址：https://platform.deepseek.com/api_keys
# 接口文档：https://api-docs.deepseek.com/zh-cn/guides/search/
# 价格：5 元 / 1000 次成功请求（搜索无结果或请求失败不计费）
# 说明：填入后需同步把 app/agents/tools.py 的 search_web 改为调用
#       POST https://api.deepseek.com/v1/tools/search
DEEPSEEK_API_KEY=<填入 DeepSeek API Key>

# ---------- LangSmith 可观测性（可选） ----------
# 不填则关闭追踪
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smart-medical-assistant

# ---------- MySQL（用户认证） ----------
# 格式：mysql+mysqlconnector://用户:密码@主机:端口/库名
DATABASE_URL=mysql+mysqlconnector://root:your_password@localhost:3306/medical_assistant

# ---------- PostgreSQL - 短记忆（对话历史 / LangGraph Checkpoint） ----------
# 注意：psycopg_pool 要求纯 postgresql:// 前缀，不能带 +psycopg
POSTGRES_SHORT_TERM_URL=postgresql://postgres:your_password@localhost:5432/smart_short

# ---------- PostgreSQL - 长记忆（用户画像 / 医疗历史） ----------
# 注意：同样是纯 postgresql:// 前缀
POSTGRES_LONG_TERM_URL=postgresql://postgres:your_password@localhost:5432/smart_long

# ---------- PostgreSQL - 会话管理（会话列表 / 消息 / 文档元数据） ----------
# 注意：走 SQLAlchemy ORM，需要 postgresql+psycopg:// 前缀
POSTGRES_SESSION_URL=postgresql+psycopg://postgres:your_password@localhost:5432/smart_session

# ---------- JWT ----------
# 生产环境请用随机串，生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
# Token 有效期（分钟），1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 服务监听 ----------
HOST=0.0.0.0
PORT=8000
